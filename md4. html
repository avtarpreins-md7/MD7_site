function calcHome(){
  const fc=CUR[S.from],tc=CUR[S.to];
  const amt=parseNum($('amt').value), rate=parseNum($('rate').value), feeVal=parseNum($('feeVal').value), spread=parseNum($('spread').value)||0;
  const ft=$('feeType').value;
