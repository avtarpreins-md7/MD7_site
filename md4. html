function parseNum(s){
  if(s===null||s===undefined) return NaN;
  s=String(s).trim(); if(!s) return NaN;
  s=s.replace(/[٠-٩]/g,d=>'٠١٢٣٤٥٦٧٨٩'.indexOf(d)).replace(/[۰-۹]/g,d=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(d))
