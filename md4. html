$('btnPdf').addEventListener('click', function () { runExport(false); });
$('btnSharePdf').addEventListener('click', function () { runExport(true); });

/* ===== حفظ المشاريع (IndexedDB) ===== */
var DB = null, dbState = 'pending', autosaveT = null;
function dbOpen() {
  try {
    var r = indexedDB.open('md4books', 1);
    r.onupgradeneeded = function () { r.result.createObjectStore('projects', { keyPath: 'id' }); };
    r.onsuccess = function () { DB = r.result; dbState = 'ok'; refreshProjects(); };
    r.onerror = function () { dbState = 'fail'; refreshProjects(); };
  } catch (e) { dbState = 'fail'; }
}
function dbPut(obj) { return new Promise(function (res, rej) { var t = DB.transaction('projects', 'readwrite'); t.objectStore('projects').put(obj); t.oncomplete = res; t.onerror = function () { rej(t.error); }; t.onabort = function () { rej(t.error || new Error('امتلأ التخزين')); }; }); }
function dbAll() { return new Promise(function (res) { var out = []; var t = DB.transaction('projects', 'readonly'), rq = t.objectStore('projects').openCursor(); rq.onsuccess = function () { var c = rq.result; if (c) { out.push(c.value); c.continue(); } else res(out); }; rq.onerror = function () { res(out); }; }); }
function dbDel(id) { return new Promise(function (res) { var t = DB.transaction('projects', 'readwrite'); t.objectStore('projects').delete(id); t.oncomplete = res; t.onerror = res; }); }
function saveProject(silent) {
  var st = $('saveStatus');
  if (dbState !== 'ok') { if (!silent) setStatus(st, 'bad', 'الحفظ داخل المتصفح غير متاح هنا (وضع خاص أو تخزين معطّل). استخدم «تصدير ملف المشروع» للاحتفاظ بنسخة.'); return Promise.resolve(false); }
  if (!S.id) S.id = uid('p');
  S.updated = Date.now();
  return dbPut(JSON.parse(JSON.stringify(S))).then(function () { if (!silent) setStatus(st, 'ok', 'تم حفظ المشروع على هذا الجهاز.'); refreshProjects(); return true; }, function (e) { setStatus(st, 'bad', 'تعذّر الحفظ: ' + (e && e.message ? e.message : 'التخزين ممتلئ') + '. صغّر عدد الصور أو صدّر ملف المشروع.'); return false; });
}
function scheduleAutosave() { if (!S.id || dbState !== 'ok') return; clearTimeout(autosaveT); autosaveT = setTimeout(function () { saveProject(true); }, 2500); }
function refreshProjects() {
  var host = $('projList'); if (!host) return;
  if (dbState === 'fail') { host.innerHTML = ''; host.appendChild(mk('p', { 'class': 'hint' }, 'الحفظ داخل المتصفح غير متاح. استخدم «تصدير ملف المشروع».')); return; }
  if (dbState !== 'ok') return;
