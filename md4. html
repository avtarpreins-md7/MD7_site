      download(blob, name); setStatus(st, 'warn', 'متصفحك لا يدعم مشاركة الملفات مباشرة، فنُزّل الملف (' + mb + ' ميغابايت). افتح مجلد التنزيلات وشاركه من هناك.');
    } else { download(blob, name); setStatus(st, 'ok', 'تم إنشاء الملف (' + blob.size.toLocaleString('en') + ' بايت ≈ ' + mb + ' ميغابايت) وبدأ تنزيله باسم ' + name + '.'); }
