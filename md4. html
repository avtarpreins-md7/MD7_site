<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MD4 Book Creator - منسّق الكتب</title>
<style>
:root{--gold:#D4AF37;--gold2:#B8860B;--bg:#050505;--card:#121212;--line:#2a2a2a;--txt:#f2f2f2;--mut:#a9a9a9;--ok:#7bd88f;--bad:#ff7b7b}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg);color:var(--txt);font-family:'Segoe UI',Tahoma,Arial,sans-serif;overflow-x:hidden}
body{padding-bottom:70px;line-height:1.7}
header{background:#000;border-bottom:2px solid var(--gold);padding:10px 14px;display:flex;align-items:center;justify-content:space-between;gap:8px;position:sticky;top:0;z-index:50}
header h1{font-size:18px;color:var(--gold);font-weight:900}
header small{color:var(--mut);font-size:11px;display:block;font-weight:400}
.pill{font-size:11px;border:1px solid var(--gold);color:var(--gold);border-radius:20px;padding:3px 10px;white-space:nowrap}
nav.tabs{display:flex;gap:6px;overflow-x:auto;padding:10px 12px;background:#0a0a0a;border-bottom:1px solid var(--line);-webkit-overflow-scrolling:touch}
nav.tabs button{flex:0 0 auto;background:transparent;color:var(--gold);border:1px solid rgba(212,175,55,.5);border-radius:20px;padding:8px 16px;font:700 13px inherit;font-family:inherit;cursor:pointer}
nav.tabs button.on{background:var(--gold);color:#000}
main{max-width:760px;margin:0 auto;padding:14px 12px}
.tab{display:none}.tab.on{display:block}
.card{background:var(--card);border:1px solid rgba(212,175,55,.45);border-radius:12px;padding:14px;margin-bottom:14px}
.card h2{color:var(--gold);font-size:17px;margin-bottom:10px}
.card h3{color:var(--gold);font-size:14px;margin:10px 0 6px}
label{display:block;font-size:13px;color:#ddd;margin:10px 0 4px}
input[type=text],textarea,select{width:100%;background:#000;color:#fff;border:1px solid #3a3a3a;border-radius:8px;padding:10px;font-family:inherit;font-size:15px}
textarea{min-height:150px;resize:vertical;line-height:1.8}
input[type=range]{width:100%}
.row{display:flex;gap:8px;flex-wrap:wrap}
.row>*{flex:1 1 140px}
.btn{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#000;border:0;border-radius:10px;padding:11px 16px;font:900 14px inherit;font-family:inherit;cursor:pointer;text-align:center;text-decoration:none;display:inline-block}
.btn.line{background:transparent;color:var(--gold);border:1px solid var(--gold)}
.btn.sm{padding:7px 11px;font-size:12px}
.btn.bad{background:transparent;color:var(--bad);border:1px solid var(--bad)}
.btn:disabled{opacity:.5}
.hint{font-size:12px;color:var(--mut);margin-top:6px}
.status{margin-top:10px;padding:10px;border-radius:8px;font-size:13px;border:1px solid var(--line)}
.status.ok{border-color:var(--ok);color:var(--ok)}.status.bad{border-color:var(--bad);color:var(--bad)}.status.warn{border-color:var(--gold);color:var(--gold)}
.chap{border:1px solid #333;border-radius:10px;padding:10px;margin-bottom:12px;background:#0b0b0b}
.thumbs{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.thumb{width:96px;border:1px solid #333;border-radius:8px;padding:4px;background:#000;font-size:11px}
.thumb img{width:100%;height:70px;object-fit:cover;border-radius:5px;display:block}
.thumb input{padding:4px;font-size:11px;margin-top:3px}
.thumb button{width:100%;margin-top:3px}
.pv-wrap{background:#1a1a1a;border-radius:10px;padding:10px;text-align:center}
#pvCanvas{width:100%;max-width:460px;height:auto;background:#fff;box-shadow:0 0 18px rgba(0,0,0,.7);display:block;margin:0 auto}
.pv-nav{display:flex;gap:8px;align-items:center;justify-content:center;margin-top:10px;flex-wrap:wrap}
.pv-nav span{font-size:13px;min-width:90px}
progress{width:100%;height:14px;margin-top:10px}
.proj{display:flex;justify-content:space-between;align-items:center;gap:8px;border:1px solid #333;border-radius:8px;padding:8px 10px;margin-top:8px;flex-wrap:wrap}
.proj b{color:var(--gold)}
.proj small{color:var(--mut);display:block}
.chk{display:flex;align-items:center;gap:8px;margin:10px 0}
.chk input{width:20px;height:20px}
.bottom{position:fixed;bottom:0;left:0;right:0;background:#000;border-top:1px solid var(--gold);padding:8px 10px;display:flex;gap:8px;justify-content:center;z-index:60}
@media (max-width:380px){header h1{font-size:15px}}
</style>
</head>
<body>
<header>
  <h1>MD4 Book Creator <small>منسّق الكتب بمقاس A5 · أداة مستقلة من MD7 Group</small></h1>
  <span class="pill" id="pageInfo">0 صفحة</span>
</header>
<nav class="tabs" id="tabs">
  <button data-tab="cover" class="on">الغلاف</button>
  <button data-tab="content">المحتوى</button>
  <button data-tab="format">التنسيق</button>
  <button data-tab="preview">معاينة</button>
  <button data-tab="export">تصدير وحفظ</button>
</nav>

<main>
<section class="tab on" id="tab-cover">
  <div class="card">
    <h2>بيانات الكتاب</h2>
    <label for="bTitle">عنوان الكتاب</label><input type="text" id="bTitle" maxlength="120">
    <label for="bSub">عنوان فرعي (اختياري)</label><input type="text" id="bSub" maxlength="160">
    <label for="bAuthor">المؤلف</label><input type="text" id="bAuthor" maxlength="80">
  </div>
  <div class="card">
    <h2>الغلاف الأمامي</h2>
    <label for="cTheme">تصميم الغلاف الجاهز (يُستخدم إن لم ترفع صورة)</label>
    <select id="cTheme"><option value="gold">أسود وذهبي</option><option value="white">كريمي أنيق</option><option value="navy">أزرق داكن</option></select>
    <div class="row" style="margin-top:10px">
      <button type="button" class="btn line" id="frontPick">رفع صورة الغلاف</button>
      <button type="button" class="btn bad sm" id="frontClear" hidden>إزالة الصورة</button>
    </div>
    <input type="file" id="frontFile" accept="image/*" hidden>
    <div class="chk"><input type="checkbox" id="cOverlay" checked><label for="cOverlay" style="margin:0">اكتب العنوان فوق صورة الغلاف</label></div>
    <div id="frontName" class="hint"></div>
  </div>
  <div class="card">
    <h2>الغلاف الخلفي (اختياري)</h2>
    <div class="row">
      <button type="button" class="btn line" id="backPick">رفع صورة الغلاف الخلفي</button>
      <button type="button" class="btn bad sm" id="backClear" hidden>إزالة الصورة</button>
    </div>
    <input type="file" id="backFile" accept="image/*" hidden>
    <label for="backText">نص خلفي (نبذة عن الكتاب)</label><textarea id="backText" style="min-height:90px" maxlength="900"></textarea>
    <div id="backName" class="hint"></div>
  </div>
</section>

<section class="tab" id="tab-content">
  <div class="card">
    <h2>فصول الكتاب</h2>
    <p class="hint">الصق النص أو ارفع ملفًا نصيًا (.txt). سطر يبدأ بـ <b>##</b> يصبح عنوانًا فرعيًا. السطر الفارغ يفصل الفقرات. الصور تُدرج في مكان المؤشر، وأي صورة لم تُدرج تُضاف في نهاية الفصل.</p>
    <div id="chapters"></div>
    <button type="button" class="btn" id="addChap">+ فصل جديد</button>
  </div>
</section>

<section class="tab" id="tab-format">
  <div class="card">
    <h2>التنسيق (A5 — 148×210 مم)</h2>
    <div class="row">
      <div><label for="fFont">الخط</label><select id="fFont"><option value="sans">عصري (Sans)</option><option value="naskh">نسخ تقليدي</option><option value="kufi">كوفي</option></select></div>
      <div><label for="fDir">اتجاه الكتاب</label><select id="fDir"><option value="rtl">عربي (من اليمين)</option><option value="ltr">إنجليزي (من اليسار)</option></select></div>
    </div>
    <label for="fSize">حجم الخط: <b id="fSizeV"></b></label><input type="range" id="fSize" min="13" max="24" step="1">
    <label for="fLh">تباعد الأسطر: <b id="fLhV"></b></label><input type="range" id="fLh" min="1.4" max="2.4" step="0.1">
    <div class="row">
      <div><label for="fMargin">الهوامش</label><select id="fMargin"><option value="narrow">ضيقة</option><option value="normal">عادية</option><option value="wide">واسعة</option></select></div>
      <div><label for="fPaper">لون الورق</label><select id="fPaper"><option value="white">أبيض</option><option value="cream">كريمي</option></select></div>
    </div>
    <div class="chk"><input type="checkbox" id="fJustify"><label for="fJustify" style="margin:0">ضبط النص من الجانبين</label></div>
    <div class="chk"><input type="checkbox" id="fIndent"><label for="fIndent" style="margin:0">مسافة بادئة لأول سطر في الفقرة</label></div>
    <div class="chk"><input type="checkbox" id="fPnum"><label for="fPnum" style="margin:0">ترقيم الصفحات</label></div>
    <div class="chk"><input type="checkbox" id="fAr"><label for="fAr" style="margin:0">أرقام عربية (١٢٣)</label></div>
    <div class="chk"><input type="checkbox" id="fTitlePage"><label for="fTitlePage" style="margin:0">صفحة العنوان بعد الغلاف</label></div>
    <div class="chk"><input type="checkbox" id="fToc"><label for="fToc" style="margin:0">فهرس المحتويات (عند وجود أكثر من فصل)</label></div>
    <p class="hint">الخطوط المستخدمة هي خطوط جهازك (لا تُحمَّل من الإنترنت). لو ظهر خط غير مناسب جرّب خطًا آخر.</p>
  </div>
</section>

<section class="tab" id="tab-preview">
  <div class="card">
    <h2>معاينة قبل التصدير</h2>
    <div class="pv-wrap"><canvas id="pvCanvas" width="10" height="10"></canvas></div>
    <div class="pv-nav">
      <button type="button" class="btn line sm" id="pvNext">التالية ›</button>
      <span id="pvLabel">—</span>
      <button type="button" class="btn line sm" id="pvPrev">‹ السابقة</button>
    </div>
    <input type="range" id="pvRange" min="1" max="1" value="1" style="margin-top:8px">
    <p class="hint">هذه المعاينة هي نفس رسم الصفحات الذي سيدخل ملف الـPDF.</p>
  </div>
</section>

<section class="tab" id="tab-export">
  <div class="card">
    <h2>تصدير PDF</h2>
    <label for="eQual">جودة الصفحات</label>
    <select id="eQual"><option value="1.5">خفيفة (≈150 نقطة/بوصة، حجم أصغر)</option><option value="2" selected>عادية (≈200 نقطة/بوصة)</option><option value="2.6">عالية للطباعة (≈260 نقطة/بوصة، حجم أكبر)</option></select>
    <div class="row" style="margin-top:12px">
      <button type="button" class="btn" id="btnPdf">تصدير PDF وتنزيله</button>
      <button type="button" class="btn line" id="btnSharePdf">مشاركة ملف الـPDF</button>
    </div>
    <progress id="expProg" value="0" max="1" hidden></progress>
    <div id="expStatus" role="status" aria-live="polite"></div>
    <p class="hint">الـPDF يحمل كل صفحة كصورة عالية الدقة بمقاس A5 حقيقي، فيظهر العربي بشكله الصحيح على أي جهاز. النص داخله غير قابل للتحديد أو البحث.</p>
  </div>

  <div class="card">
    <h2>حفظ المشاريع</h2>
    <p class="hint">يُحفظ المشروع داخل متصفح هذا الجهاز فقط (ليس على خادم). لنقله لجهاز آخر أو لأخذ نسخة احتياطية استخدم «تصدير ملف المشروع».</p>
    <div class="row" style="margin-top:8px">
      <button type="button" class="btn" id="btnSave">حفظ المشروع</button>
      <button type="button" class="btn line" id="btnNew">مشروع جديد</button>
      <button type="button" class="btn line" id="btnSample">تحميل مثال تجريبي</button>
    </div>
    <div id="saveStatus" role="status" aria-live="polite"></div>
    <h3>مشاريعك المحفوظة</h3>
    <div id="projList"><p class="hint">لا توجد مشاريع محفوظة.</p></div>
  </div>

  <div class="card">
    <h2>ملف المشروع (نسخة احتياطية / نقل)</h2>
    <div class="row">
      <button type="button" class="btn line" id="btnExpProj">تصدير ملف المشروع</button>
      <button type="button" class="btn line" id="btnShareProj">مشاركة ملف المشروع</button>
      <button type="button" class="btn line" id="btnImpProj">استيراد ملف مشروع</button>
    </div>
    <input type="file" id="impFile" accept=".json,application/json" hidden>
    <div id="fileStatus" role="status" aria-live="polite"></div>
  </div>

  <div class="card">
    <h2>تحتاج نشر أو طباعة الكتاب؟</h2>
    <p class="hint">لطلب عقد نشر أو شراكة مع MD7 Group.</p>
    <button type="button" class="btn" id="btnContract" style="margin-top:8px">طلب عقد / شراكة عبر واتساب</button>
    <div id="contractStatus" role="status" aria-live="polite"></div>
  </div>
</section>
</main>

<div class="bottom">
  <button type="button" class="btn line sm" data-go="preview">معاينة</button>
  <button type="button" class="btn sm" data-go="export">تصدير وحفظ</button>
</div>

<script>
(function () {
'use strict';

/* ===== إعدادات (عدّلها هنا فقط) ===== */
var CONFIG = {
  whatsappNumber: '',   // رقم واتساب الدولي أرقامًا فقط (مثال: 20xxxxxxxxxx). فارغ = لا يُفتح واتساب ويُعرض بديل
  contactEmail: 'avtarpreins@gmail.com'
};

var LW = 592, LH = 840;                 // A5 بوحدات منطقية (4 وحدات = 1 مم)
var PT_W = 419.53, PT_H = 595.28;       // A5 بالنقاط
var FONTS = {
  sans: '"Segoe UI","Noto Sans Arabic","Noto Naskh Arabic",Tahoma,Arial,sans-serif',
  naskh: '"Amiri","Noto Naskh Arabic","Traditional Arabic","Simplified Arabic",Georgia,serif',
  kufi: '"Noto Kufi Arabic","Noto Sans Arabic",Tahoma,Arial,sans-serif'
};
var THEMES = {
  gold: { bg: '#0a0a0a', bg2: '#1a1405', accent: '#D4AF37', text: '#D4AF37', sub: '#e9d58f' },
  white: { bg: '#faf7ef', bg2: '#efe6cf', accent: '#8a6d1d', text: '#1a1a1a', sub: '#555' },
  navy: { bg: '#0b1b33', bg2: '#12305a', accent: '#e8c56a', text: '#ffffff', sub: '#cfd8e6' }
};

function $(id) { return document.getElementById(id); }
function uid(p) { return p + Math.random().toString(36).slice(2, 8); }
function mk(tag, attrs, text) {
  var e = document.createElement(tag), k;
  if (attrs) for (k in attrs) { if (k === 'class') e.className = attrs[k]; else e.setAttribute(k, attrs[k]); }
  if (text != null) e.textContent = text;
  return e;
}
function setStatus(el, kind, msg) { el.className = 'status ' + kind; el.textContent = msg; }
function clearStatus(el) { el.className = ''; el.textContent = ''; }

/* ===== الحالة ===== */
function newChapter(t) { return { id: uid('c'), title: t || '', text: '', imgs: [] }; }
function newBook() {
  return {
    id: null, title: '', subtitle: '', author: '',
    cover: { front: null, back: null, theme: 'gold', overlay: true, backText: '' },
    chapters: [newChapter('الفصل الأول')],
    images: {},
    fmt: { font: 'sans', dir: 'rtl', size: 17, lh: 1.9, margin: 'normal', paper: 'white', justify: true, indent: true, pnum: true, ar: true, titlePage: true, toc: true },
    updated: 0
  };
}
var S = newBook(), ver = 0, pagesCache = null, pagesVer = -1;
function touch() { ver++; scheduleAutosave(); }

/* ===== الصور ===== */
var imgEls = {};
function loadImg(id) {
  return new Promise(function (res) {
    if (imgEls[id]) { res(imgEls[id]); return; }
    var rec = S.images[id];
    if (!rec) { res(null); return; }
    var im = new Image();
    im.onload = function () { imgEls[id] = im; res(im); };
    im.onerror = function () { res(null); };
    im.src = rec.data;
  });
}
// يقرأ صورة ويصغّرها (للذاكرة وللحفظ) ويرجع سجلًا {name,data,w,h}
function readImage(file) {
  return new Promise(function (res, rej) {
    if (!file || !/^image\//.test(file.type)) { rej(new Error('الملف ليس صورة')); return; }
    var fr = new FileReader();
    fr.onerror = function () { rej(new Error('تعذّرت قراءة الملف')); };
    fr.onload = function () {
      var im = new Image();
      im.onerror = function () { rej(new Error('الصورة تالفة أو بصيغة غير مدعومة')); };
      im.onload = function () {
        var MAX = 2000, sc = Math.min(1, MAX / Math.max(im.naturalWidth, im.naturalHeight));
        var w = Math.max(1, Math.round(im.naturalWidth * sc)), h = Math.max(1, Math.round(im.naturalHeight * sc));
        var c = document.createElement('canvas'); c.width = w; c.height = h;
        var x = c.getContext('2d'); x.fillStyle = '#fff'; x.fillRect(0, 0, w, h); x.drawImage(im, 0, 0, w, h);
        res({ name: file.name || 'image', data: c.toDataURL('image/jpeg', 0.88), w: w, h: h });
      };
      im.src = fr.result;
    };
    fr.readAsDataURL(file);
  });
}
function addImage(file) {
  return readImage(file).then(function (rec) { var id = uid('i'); S.images[id] = rec; return id; });
}

/* ===== الترتيب والتصفح (Layout) ===== */
function geom() {
  var m = { narrow: [40, 48, 38], normal: [60, 64, 52], wide: [76, 80, 70] }[S.fmt.margin] || [60, 64, 52];
  return { mt: m[0], mb: m[1], ms: m[2] };
}
function toDigits(n) { return S.fmt.ar ? String(n).replace(/\d/g, function (d) { return '٠١٢٣٤٥٦٧٨٩'.charAt(+d); }) : String(n); }

function wrapPara(ctx, text, maxW, firstIndent) {
  var toks = text.split(/\s+/).filter(Boolean), sp = ctx.measureText(' ').width, lines = [], cur = [], cw = 0, avail = maxW - firstIndent, first = true, i;
  function flush(last) { lines.push({ words: cur, width: cw, last: !!last, indent: first ? firstIndent : 0 }); first = false; avail = maxW; cur = []; cw = 0; }
  for (i = 0; i < toks.length; i++) {
    var s = toks[i], w = ctx.measureText(s).width;
    if (w > avail) { // كلمة أطول من السطر: تُقسّم حرفيًا
      if (cur.length) flush(false);
      var part = '', j;
      for (j = 0; j < s.length; j++) {
        var t = part + s.charAt(j);
        if (ctx.measureText(t).width > avail && part) { cur = [{ s: part, w: ctx.measureText(part).width }]; cw = cur[0].w; flush(false); part = s.charAt(j); } else part = t;
      }
      s = part; w = ctx.measureText(s).width;
    }
    if (cur.length && cw + sp + w > avail) flush(false);
    cur.push({ s: s, w: w }); cw += (cur.length > 1 ? sp : 0) + w;
  }
  if (cur.length) flush(true); else if (!lines.length) return [];
  if (lines.length) lines[lines.length - 1].last = true;
  return lines;
}

function buildPages() {
  if (pagesCache && pagesVer === ver) return pagesCache;
  var f = S.fmt, g = geom(), pages = [], mc = document.createElement('canvas').getContext('2d');
  var fs = f.size, lh = fs * f.lh, textW = LW - 2 * g.ms, limit = LH - g.mb, y = g.mt, cur = null;
  function font(sz, w) { return (w || 'normal') + ' ' + sz + 'px ' + FONTS[f.font]; }
  function newPage() { cur = { t: 'content', items: [] }; pages.push(cur); y = g.mt; return cur; }

  pages.push({ t: 'cover' });
  if (f.titlePage) pages.push({ t: 'title' });
  var tocPages = [], useToc = f.toc && S.chapters.length > 1;
  if (useToc) {
    var per = Math.max(1, Math.floor((LH - g.mt - g.mb - fs * 4) / (lh * 1.1)));
    var np = Math.max(1, Math.ceil(S.chapters.length / per));
    for (var q = 0; q < np; q++) { var tp = { t: 'toc', items: [], first: q === 0 }; tocPages.push(tp); pages.push(tp); }
    tocPages.per = per;
  }
  var firstContent = pages.length, entries = [];

  function placeImage(id, cap) {
    var im = S.images[id]; if (!im) return;
    var maxH = (limit - g.mt) * 0.78, sc = Math.min(textW / im.w, maxH / im.h), w = im.w * sc, h = im.h * sc, capH = cap ? lh * 1.2 : 0;
    if (y + h + capH > limit && y > g.mt + 1) newPage();
    cur.items.push({ k: 'img', id: id, x: (LW - w) / 2, y: y, w: w, h: h });
    y += h + 6;
    if (cap) { cur.items.push({ k: 'cap', text: cap, y: y + lh * 0.5 }); y += capH; }
    y += lh * 0.5;
  }

  S.chapters.forEach(function (ch, ci) {
    newPage();
    var title = (ch.title || '').trim() || ('الفصل ' + (ci + 1));
