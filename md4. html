<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>MD Currency Exchange</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#07070a; --bg2:#0d0d12; --card:#111116; --card2:#17171e;
  --gold:#d4af37; --gold2:#f3d98b; --gold3:#8c6d12;
  --silver:#c0c5ce; --silver2:#7d8491; --line:rgba(192,197,206,.22);
  --white:#fff; --green:#3ddc97; --red:#ff5d6c;
  --cc:#d4af37;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(1200px 600px at 80% -10%,rgba(212,175,55,.14),transparent 60%),radial-gradient(900px 500px at -10% 10%,rgba(192,197,206,.07),transparent 60%),var(--bg);
  color:var(--white);font-family:'Tajawal','Segoe UI',Tahoma,Arial,sans-serif;min-height:100vh;line-height:1.55}
.app{max-width:1100px;margin:0 auto;padding:14px 14px 40px;padding-bottom:calc(40px + env(safe-area-inset-bottom))}
header{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 4px 14px}
.logo{width:50px;height:50px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:19px;color:#1a1405;
  background:conic-gradient(from 210deg,var(--gold2),var(--gold),var(--gold3),var(--gold2));box-shadow:0 0 22px rgba(212,175,55,.45), inset 0 0 0 2px rgba(255,255,255,.35)}
.brand h1{margin:0;font-size:20px;letter-spacing:.3px;background:linear-gradient(90deg,var(--gold2),var(--gold),#fff6d6);-webkit-background-clip:text;background-clip:text;color:transparent}
.brand p{margin:0;color:var(--silver);font-size:13px}
.hdr-actions{margin-inline-start:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);background:rgba(255,255,255,.03);color:var(--silver);padding:6px 11px;border-radius:999px;font-size:12.5px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--silver2)}
.dot.live{background:var(--green);box-shadow:0 0 8px var(--green)}
.dot.cached{background:var(--gold);box-shadow:0 0 8px var(--gold)}
.dot.err{background:var(--red)}
button{font-family:inherit}
.btn{cursor:pointer;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--white);padding:9px 14px;border-radius:12px;font-size:14px;transition:.15s}
.btn:hover{border-color:var(--gold);box-shadow:0 0 14px rgba(212,175,55,.2)}
.btn.gold{background:linear-gradient(135deg,var(--gold2),var(--gold) 55%,var(--gold3));color:#1b1405;border-color:transparent;font-weight:700}
.btn.sm{padding:6px 10px;font-size:12.5px;border-radius:10px}
.btn.danger:hover{border-color:var(--red);box-shadow:0 0 14px rgba(255,93,108,.25)}
.banner{border:1px solid rgba(255,93,108,.5);background:rgba(255,93,108,.09);color:#ffd0d4;padding:10px 14px;border-radius:12px;margin-bottom:12px;display:flex;gap:10px;align-items:center;font-size:14px}
.banner.info{border-color:rgba(212,175,55,.5);background:rgba(212,175,55,.08);color:var(--gold2)}
.banner button{margin-inline-start:auto}
.tabs{display:flex;gap:6px;overflow-x:auto;padding:4px 2px 10px;scrollbar-width:none;position:sticky;top:0;z-index:20;background:linear-gradient(var(--bg) 70%,transparent)}
.tabs::-webkit-scrollbar{display:none}
.tab-btn{flex:0 0 auto;cursor:pointer;border:1px solid var(--line);background:transparent;color:var(--silver);padding:9px 16px;border-radius:999px;font-size:14.5px;white-space:nowrap}
.tab-btn.active{color:#1b1405;background:linear-gradient(135deg,var(--gold2),var(--gold));border-color:transparent;font-weight:700;box-shadow:0 0 18px rgba(212,175,55,.3)}
.tab{display:none}.tab.active{display:block}
.grid{display:grid;gap:14px}
.g2{grid-template-columns:1.25fr 1fr}
@media(max-width:860px){.g2{grid-template-columns:1fr}}
.card{background:linear-gradient(160deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:20px;padding:18px;position:relative;box-shadow:0 10px 30px rgba(0,0,0,.45)}
.card::before{content:"";position:absolute;inset:0;border-radius:20px;pointer-events:none;background:linear-gradient(135deg,rgba(212,175,55,.12),transparent 35%);}
.card h2{margin:0 0 12px;font-size:17px;color:var(--gold);display:flex;align-items:center;gap:8px}
.card h3{margin:14px 0 8px;font-size:14px;color:var(--silver)}
label{display:block;color:var(--silver);font-size:13px;margin-bottom:5px}
input,select{width:100%;background:#0a0a0e;border:1px solid var(--line);color:var(--white);border-radius:12px;padding:11px 12px;font-size:16px;font-family:inherit;outline:none}
input:focus,select:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15)}
input.num{direction:ltr;text-align:start;font-variant-numeric:tabular-nums}
html[dir=rtl] input.num{text-align:right}
.row{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-bottom:12px}
.pair{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:end;margin-bottom:12px}
@media(max-width:560px){.pair{grid-template-columns:1fr;}.pair .swap{justify-self:center;transform:rotate(90deg)}}
.swap{width:44px;height:44px;border-radius:50%;border:1px solid var(--gold);background:rgba(212,175,55,.1);color:var(--gold2);font-size:20px;cursor:pointer}
.swap:hover{background:rgba(212,175,55,.25)}
.curbtn{width:100%;display:flex;align-items:center;gap:10px;text-align:start;cursor:pointer;background:#0a0a0e;color:#fff;border:1.5px solid var(--cc);border-radius:14px;padding:7px 10px;box-shadow:0 0 14px color-mix(in srgb,var(--cc) 30%,transparent)}
.curbtn .thumb{width:62px;flex:0 0 62px}
.curbtn .meta{min-width:0;flex:1}
.curbtn .code{font-weight:800;color:var(--cc);filter:brightness(1.35);font-size:16px}
.curbtn .nm{font-size:12px;color:var(--silver);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.curbtn .car{color:var(--silver2)}
.thumb svg,.note svg{display:block;width:100%;height:auto;border-radius:7px}
.result{margin-top:6px;border:1px solid rgba(212,175,55,.45);border-radius:18px;padding:16px;background:linear-gradient(145deg,rgba(212,175,55,.1),rgba(0,0,0,.2))}
.big{font-size:30px;font-weight:800;color:var(--gold2);direction:ltr;text-align:start;word-break:break-all;font-variant-numeric:tabular-nums}
html[dir=rtl] .big{text-align:right}
.kv{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px dashed var(--line);font-size:14px}
.kv:last-child{border-bottom:0}
.kv span:first-child{color:var(--silver)}
.kv b{direction:ltr;font-variant-numeric:tabular-nums;text-align:end}
.bar{height:9px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden;display:flex;margin:10px 0 2px}
.bar i{display:block;height:100%}
.hint{color:var(--silver2);font-size:12.5px;margin-top:6px}
.warn{color:#ffb4bb;font-size:13px;margin-top:6px}
.badge{display:inline-block;font-size:12px;padding:3px 9px;border-radius:99px;border:1px solid var(--line);color:var(--silver)}
.badge.live{color:var(--green);border-color:rgba(61,220,151,.5)}
.badge.cached{color:var(--gold2);border-color:rgba(212,175,55,.5)}
.badge.manual{color:#ffd28a;border-color:rgba(255,190,90,.5)}
.badge.none{color:#ffb4bb;border-color:rgba(255,93,108,.5)}
.verdict{border-radius:18px;padding:16px;text-align:center;border:1.5px solid var(--silver);background:rgba(192,197,206,.07)}
.verdict.gain{border-color:var(--green);background:rgba(61,220,151,.09);box-shadow:0 0 24px rgba(61,220,151,.15)}
.verdict.loss{border-color:var(--red);background:rgba(255,93,108,.09);box-shadow:0 0 24px rgba(255,93,108,.15)}
.verdict .v{font-size:30px;font-weight:800;direction:ltr;font-variant-numeric:tabular-nums}
.verdict.gain .v{color:var(--green)}.verdict.loss .v{color:var(--red)}.verdict.tie .v{color:var(--silver)}
.verdict .t{font-size:14px;color:var(--silver)}
.fav{display:flex;align-items:center;gap:10px;padding:8px;border:1px solid var(--line);border-radius:14px;margin-bottom:8px;border-inline-start:4px solid var(--cc)}
.fav .thumb{width:58px;flex:0 0 58px}
.fav .meta{flex:1;min-width:0}
.fav .code{font-weight:800;color:var(--cc);filter:brightness(1.4)}
.fav .val{font-size:12.5px;color:var(--silver);direction:ltr;text-align:start}
html[dir=rtl] .fav .val{text-align:right}
.fav .acts{display:flex;gap:5px}
.offer{border:1px solid var(--line);border-radius:16px;padding:12px;margin-bottom:10px;background:rgba(255,255,255,.02)}
.offer-h{display:flex;gap:8px;align-items:center;margin-bottom:8px}
.offer-h input{font-weight:700}
.rank{display:flex;gap:10px;align-items:center;border:1px solid var(--line);border-radius:14px;padding:11px;margin-bottom:8px}
.rank.best{border-color:var(--gold);background:linear-gradient(135deg,rgba(212,175,55,.14),transparent);box-shadow:0 0 18px rgba(212,175,55,.2)}
.rank .no{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:800;background:rgba(192,197,206,.15);color:var(--silver);flex:0 0 34px}
.rank.best .no{background:linear-gradient(135deg,var(--gold2),var(--gold));color:#1b1405}
.rank .info{flex:1;min-width:0}
.rank .net{font-weight:800;direction:ltr;color:var(--gold2);font-variant-numeric:tabular-nums}
.rank.pending{opacity:.6}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:14px}
table{border-collapse:collapse;width:100%;font-size:13.5px;min-width:820px}
th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:start;white-space:nowrap}
th{color:var(--gold);background:rgba(212,175,55,.07);position:sticky;top:0}
td.ltr{direction:ltr;text-align:end;font-variant-numeric:tabular-nums}
.pos{color:var(--green)}.neg{color:var(--red)}.zero{color:var(--silver)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.recent{display:flex;justify-content:space-between;gap:8px;padding:8px 0;border-bottom:1px dashed var(--line);font-size:13.5px}
.recent:last-child{border-bottom:0}
.recent b{direction:ltr}
footer{margin-top:22px;color:var(--silver2);font-size:12.5px;text-align:center;line-height:1.8}
footer a{color:var(--gold)}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.78);backdrop-filter:blur(4px);z-index:100;display:flex;align-items:flex-end;justify-content:center}
@media(min-width:700px){.modal{align-items:center}}
.sheet{width:100%;max-width:640px;max-height:88vh;display:flex;flex-direction:column;background:#0e0e13;border:1px solid var(--gold);border-radius:22px 22px 0 0;padding:14px;box-shadow:0 0 40px rgba(212,175,55,.25)}
@media(min-width:700px){.sheet{border-radius:22px}}
.sheet-h{display:flex;gap:8px;align-items:center;margin-bottom:10px}
.plist{overflow-y:auto;flex:1;padding-inline-end:2px}
.prow{display:flex;align-items:center;gap:10px;padding:8px;border-radius:14px;cursor:pointer;border:1px solid transparent;border-inline-start:4px solid var(--cc);margin-bottom:6px;background:rgba(255,255,255,.025)}
.prow:hover{border-color:var(--cc);background:rgba(255,255,255,.06)}
.prow .thumb{width:64px;flex:0 0 64px}
.prow .meta{flex:1;min-width:0}
.prow .code{font-weight:800;color:var(--cc);filter:brightness(1.4)}
.prow .nm{font-size:13.5px}
.prow .ct{font-size:12px;color:var(--silver2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.star{background:none;border:0;font-size:22px;color:var(--silver2);cursor:pointer;padding:4px 8px}
.star.on{color:var(--gold)}
#toast{position:fixed;bottom:22px;inset-inline:0;margin:auto;width:max-content;max-width:90vw;background:var(--gold);color:#1b1405;padding:10px 18px;border-radius:99px;font-weight:700;z-index:200;opacity:0;pointer-events:none;transition:.25s;transform:translateY(10px)}
#toast.show{opacity:1;transform:none}
#chart svg{width:100%;height:auto;display:block}
#printArea{display:none}
@media print{
  body{background:#fff!important;color:#000!important}
  .app,.modal,#toast{display:none!important}
  #printArea{display:block!important;color:#000;font-family:Tahoma,Arial,sans-serif}
  #printArea h1{color:#8c6d12;margin:0 0 4px}
  #printArea table{min-width:0;font-size:11px;width:100%}
  #printArea th{background:#f1e7c3;color:#000;position:static}
  #printArea th,#printArea td{border:1px solid #999;padding:4px 6px;white-space:normal}
  #printArea .pos{color:#0a7a3c}#printArea .neg{color:#b00020}
}
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="logo">MD</div>
    <div class="brand">
      <h1>MD Currency Exchange</h1>
      <p data-i18n="tagline"></p>
    </div>
    <div class="hdr-actions">
      <span class="pill" id="statusPill"><i class="dot" id="statusDot"></i><span id="statusTxt"></span></span>
      <button class="btn sm" id="refreshBtn" data-i18n="refresh"></button>
      <button class="btn sm" id="langBtn">EN</button>
    </div>
  </header>

  <div class="banner" id="banner" hidden><span id="bannerTxt"></span><button class="btn sm" id="bannerClose">✕</button></div>

  <nav class="tabs" id="tabs">
    <button class="tab-btn active" data-tab="home" data-i18n="tabHome"></button>
    <button class="tab-btn" data-tab="pnl" data-i18n="tabPnl"></button>
    <button class="tab-btn" data-tab="cmp" data-i18n="tabCmp"></button>
    <button class="tab-btn" data-tab="hist" data-i18n="tabHist"></button>
  </nav>

  <!-- HOME -->
  <section class="tab active" id="tab-home">
    <div class="grid g2">
      <div class="card">
        <h2>⇄ <span data-i18n="convTitle"></span></h2>
        <div class="row" style="grid-template-columns:1fr">
          <div><label for="amt" data-i18n="amount"></label><input class="num" id="amt" inputmode="decimal" value="200" autocomplete="off"></div>
        </div>
        <div class="pair">
          <div><label data-i18n="fromCur"></label><button class="curbtn" id="fromBtn"></button></div>
          <button class="swap" id="swapBtn" title="⇄">⇄</button>
          <div><label data-i18n="toCur"></label><button class="curbtn" id="toBtn"></button></div>
        </div>
        <div class="row" style="grid-template-columns:1fr auto;align-items:end">
          <div><label for="rate"><span data-i18n="rateLbl"></span></label><input class="num" id="rate" inputmode="decimal" autocomplete="off" placeholder="0.00"></div>
          <button class="btn" id="useMarket" data-i18n="useMarket"></button>
        </div>
        <div style="margin:-4px 0 12px"><span class="badge" id="rateBadge"></span></div>
        <div class="row">
          <div><label for="feeType" data-i18n="feeType"></label>
            <select id="feeType"><option value="none" data-i18n="feeNone"></option><option value="pct" data-i18n="feePct"></option><option value="fix" data-i18n="feeFix"></option></select></div>
          <div><label for="feeVal"><span data-i18n="feeVal"></span> <span id="feeUnit"></span></label><input class="num" id="feeVal" inputmode="decimal" value="0" autocomplete="off"></div>
          <div><label for="spread" data-i18n="spread"></label><input class="num" id="spread" inputmode="decimal" value="0" autocomplete="off"></div>
        </div>
        <div class="result" id="homeRes">
          <div class="hint" data-i18n="netL"></div>
          <div class="big" id="outNet">—</div>
          <div class="bar" id="shareBar"></div>
          <div class="hint" id="shareTxt"></div>
          <div style="margin-top:8px">
            <div class="kv"><span data-i18n="grossL"></span><b id="outGross">—</b></div>
            <div class="kv"><span data-i18n="feeL"></span><b id="outFee">—</b></div>
            <div class="kv"><span data-i18n="rateUsed"></span><b id="outRate">—</b></div>
            <div class="kv"><span data-i18n="invRate"></span><b id="outInv">—</b></div>
            <div class="kv"><span data-i18n="buyRate"></span><b id="outBuy">—</b></div>
            <div class="kv"><span data-i18n="sellRate"></span><b id="outSell">—</b></div>
            <div class="kv"><span data-i18n="rateTime"></span><b id="outTime" style="direction:inherit">—</b></div>
          </div>
          <div class="warn" id="homeWarn"></div>
          <div class="toolbar"><button class="btn gold" id="saveConv" data-i18n="saveOp"></button></div>
          <div class="hint" data-i18n="marketNote"></div>
        </div>
      </div>

      <div class="grid" style="align-content:start">
        <div class="card">
          <h2>★ <span data-i18n="favTitle"></span></h2>
          <div id="favList"></div>
          <button class="btn sm" id="addFav" data-i18n="addFav"></button>
        </div>
        <div class="card">
          <h2>🕘 <span data-i18n="recentTitle"></span></h2>
          <div id="recentList"></div>
        </div>
      </div>
    </div>

    <div class="card" style="margin-top:14px">
      <h2>📈 <span data-i18n="chartTitle"></span></h2>
      <div id="chart"></div>
      <div class="hint" data-i18n="chartNote"></div>
    </div>
  </section>

  <!-- PNL -->
  <section class="tab" id="tab-pnl">
    <div class="grid g2">
      <div class="card">
        <h2>⚖ <span data-i18n="pnlTitle"></span></h2>
        <div class="hint" style="margin:-6px 0 12px" data-i18n="pnlIntro"></div>
        <div class="row" style="grid-template-columns:1fr"><div><label for="cap" data-i18n="capital"></label><input class="num" id="cap" inputmode="decimal" value="1000" autocomplete="off"></div></div>
        <div class="pair">
          <div><label data-i18n="capCur"></label><button class="curbtn" id="paBtn"></button></div>
          <button class="swap" id="pnlSwap">⇄</button>
          <div><label data-i18n="midCur"></label><button class="curbtn" id="pbBtn"></button></div>
        </div>
        <div class="row">
          <div><label for="r1"><span data-i18n="rate1"></span> <span id="r1u" class="car"></span></label><input class="num" id="r1" inputmode="decimal" autocomplete="off" placeholder="0.00"></div>
          <div><label for="f1"><span data-i18n="fee1"></span> <span id="f1u"></span></label><input class="num" id="f1" inputmode="decimal" value="0" autocomplete="off"></div>
        </div>
        <div class="row">
          <div><label for="r2"><span data-i18n="rate2"></span> <span id="r2u" class="car"></span></label><input class="num" id="r2" inputmode="decimal" autocomplete="off" placeholder="0.00"></div>
          <div><label for="f2"><span data-i18n="fee2"></span> <span id="f2u"></span></label><input class="num" id="f2" inputmode="decimal" value="0" autocomplete="off"></div>
        </div>
        <div class="toolbar"><button class="btn" id="pnlFill" data-i18n="pnlFill"></button></div>
        <div class="hint" data-i18n="pnlFillNote"></div>
        <div class="warn" id="pnlErr"></div>
      </div>
      <div class="grid" style="align-content:start">
        <div class="verdict tie" id="verdict"><div class="t" id="vTitle">—</div><div class="v" id="vVal">—</div><div class="t" id="vPct"></div></div>
        <div class="card" id="pnlDetails">
          <h2>🧾 <span data-i18n="details"></span></h2>
          <div class="kv"><span data-i18n="p_cap"></span><b id="p_cap">—</b></div>
          <div class="kv"><span data-i18n="p_g1"></span><b id="p_g1">—</b></div>
          <div class="kv"><span data-i18n="p_f1"></span><b id="p_f1">—</b></div>
          <div class="kv"><span data-i18n="p_a1"></span><b id="p_a1">—</b></div>
          <div class="kv"><span data-i18n="p_g2"></span><b id="p_g2">—</b></div>
          <div class="kv"><span data-i18n="p_f2"></span><b id="p_f2">—</b></div>
          <div class="kv"><span data-i18n="p_fees"></span><b id="p_fees">—</b></div>
          <div class="kv"><span data-i18n="p_rec"></span><b id="p_rec">—</b></div>
          <div class="kv"><span data-i18n="p_be"></span><b id="p_be">—</b></div>
          <div class="toolbar"><button class="btn gold" id="savePnl" data-i18n="saveOp"></button></div>
        </div>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="tab" id="tab-cmp">
    <div class="grid g2">
      <div class="card">
        <h2>☰ <span data-i18n="cmpTitle"></span></h2>
        <div class="hint" style="margin:-6px 0 12px" data-i18n="cmpIntro"></div>
        <div class="row" style="grid-template-columns:1fr"><div><label for="cmpAmt" data-i18n="amount"></label><input class="num" id="cmpAmt" inputmode="decimal" value="1000" autocomplete="off"></div></div>
        <div class="pair">
          <div><label data-i18n="fromCur"></label><button class="curbtn" id="cfBtn"></button></div>
          <button class="swap" id="cmpSwap">⇄</button>
          <div><label data-i18n="toCur"></label><button class="curbtn" id="ctBtn"></button></div>
