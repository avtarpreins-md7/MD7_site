  $('feeType').addEventListener('change',calcHome);
  $('rate').addEventListener('input',()=>{S.manual=true;calcHome();});
  $('useMarket').onclick=()=>{S.manual=false;if(!cross(S.from,S.to))showBanner(t('cmpRefNone'),true);syncRate();};
  $('saveConv').onclick=saveConv;
  $('addFav').onclick=()=>openPicker(code=>{if(!S.favs.includes(code)){S.favs.push(code);save();renderFavs();}});
  $('favList').addEventListener('click',e=>{
    const b=e.target.closest('button');if(!b)return;
    if(b.dataset.fto){S.to=b.dataset.fto;if(S.from===S.to)S.from=S.from==='USD'?'EUR':'USD';save();homeChange();}
    else if(b.dataset.ffrom){S.from=b.dataset.ffrom;if(S.from===S.to)S.to=S.to==='USD'?'EUR':'USD';save();homeChange();}
    else if(b.dataset.fdel){toggleFav(b.dataset.fdel);}
  });
  // الربح والخسارة
  const pnlCh=()=>{setCurBtn('paBtn',S.pa);setCurBtn('pbBtn',S.pb);$('r1').value='';$('r2').value='';pnlAutoRates(true);};
  $('paBtn').onclick=()=>pick('pa',pnlCh); $('pbBtn').onclick=()=>pick('pb',pnlCh);
  $('pnlSwap').onclick=()=>{[S.pa,S.pb]=[S.pb,S.pa];save();pnlCh();};
  ['cap','r1','f1','r2','f2'].forEach(i=>$(i).addEventListener('input',calcPnlUI));
  $('pnlFill').onclick=()=>{pnlAutoRates(true);if(!cross(S.pa,S.pb))showBanner(t('cmpRefNone'),true);};
  $('savePnl').onclick=savePnl;
  // المقارنة
  const cmpCh=()=>{save();renderOffers();renderCmp();};
  $('cfBtn').onclick=()=>pick('cf',cmpCh); $('ctBtn').onclick=()=>pick('ct',cmpCh);
  $('cmpSwap').onclick=()=>{[S.cf,S.ct]=[S.ct,S.cf];cmpCh();};
  $('cmpAmt').addEventListener('input',rankOffers);
  $('offers').addEventListener('input',e=>{
    const card=e.target.closest('.offer'),f=e.target.dataset.f;if(!card||!f)return;
    S.offers[+card.dataset.i][f]=e.target.value; save(); rankOffers();
  });
  $('offers').addEventListener('click',e=>{
    const b=e.target.closest('button');if(!b)return;
    if(b.dataset.del!==undefined){S.offers.splice(+b.dataset.del,1);save();renderOffers();rankOffers();}
    else if(b.dataset.mkt!==undefined){const m=cross(S.cf,S.ct);if(!m){showBanner(t('cmpRefNone'),true);return;}S.offers[+b.dataset.mkt].rate=rateStr(m);save();renderOffers();rankOffers();}
  });
  $('addOffer').onclick=()=>{S.offers.push(newOffer());save();renderOffers();rankOffers();};
  // السجل
  ['hSearch','hCur','hFrom','hTo'].forEach(i=>$(i).addEventListener('input',renderHistory));
  $('hBody').addEventListener('click',e=>{const b=e.target.closest('[data-hdel]');if(!b)return;if(confirm(t('confirmDel'))){S.history=S.history.filter(x=>x.id!==b.dataset.hdel);save();renderHistory();renderRecent();}});
  $('expCsv').onclick=exportCsv; $('printBtn').onclick=printReport;
  $('clearAll').onclick=()=>{if(S.history.length&&confirm(t('confirmClear'))){S.history=[];save();renderHistory();renderRecent();}};
  // نافذة الاختيار
  $('pkSearch').addEventListener('input',()=>renderPicker());
  $('pkClose').onclick=closePicker;
  $('modal').addEventListener('click',e=>{if(e.target.id==='modal')closePicker();});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!$('modal').hidden)closePicker();});
  $('pkList').addEventListener('click',e=>{
    const st=e.target.closest('[data-star]'); if(st){toggleFav(st.dataset.star);renderPicker(true);return;}
    const row=e.target.closest('.prow'); if(row&&pickCb){const cb=pickCb;closePicker();cb(row.dataset.code);}
  });
  applyLang();
  pnlAutoRates(false);
  if(!S.rates) showBanner(t('stNone'),true);
  fetchRates();
}
init();
</script>
</body>
</html>

