  if(!/^[+-]?(\d+\.?\d*|\.\d+)(e[+-]?\d+)?$/i.test(s)) return NaN;
  const v=parseFloat(s); return isFinite(v)?v:NaN;
}
/* التحويل: المبلغ قبل الرسوم = المبلغ × السعر ، الرسوم: نسبة من المبلغ قبل الرسوم أو مبلغ ثابت بعملة الاستلام */
function calcConvert(o){
  const gross=o.amt*o.rate;
  let fee=0;
  if(o.feeType==='pct') fee=gross*o.feeVal/100;
  else if(o.feeType==='fix') fee=o.feeVal;
  return {gross,fee,net:gross-fee};
}
/* الربح والخسارة (المعادلات المطلوبة حرفيًا) */
function calcPnl(o){
  const gross1=o.cap*o.r1;            // المبلغ قبل الرسوم = المبلغ الأصلي × سعر التحويل
  const after1=gross1-o.f1;           // المبلغ بعد الرسوم = قبل الرسوم − رسوم التحويل
  const gross2=after1*o.r2;           // بعد إعادة التحويل قبل الرسوم
  const recovered=gross2-o.f2;        // المسترد = بعد الرسوم × سعر إعادة التحويل − رسوم إعادة التحويل
  const pnl=recovered-o.cap;          // صافي الربح/الخسارة
  const pct=pnl/o.cap*100;            // النسبة
  const be=after1>0?(o.cap+o.f2)/after1:NaN; // سعر إعادة التحويل اللازم للتعادل
  return {gross1,after1,gross2,recovered,pnl,pct,be};
}
