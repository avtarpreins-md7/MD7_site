  if (file && navigator.canShare && navigator.canShare({ files: [file] })) navigator.share({ files: [file], title: S.title || 'مشروع كتاب' }).then(function () { setStatus(st, 'ok', 'فُتحت قائمة المشاركة.'); }, function () { setStatus(st, 'warn', 'أُلغيت المشاركة.'); });
  else { download(projectBlob(), name); setStatus(st, 'warn', 'مشاركة الملفات غير مدعومة في متصفحك، فنُزّل الملف لتشاركه يدويًا.'); }
