  var b = newBook(), id, k;
  b.title = str(o.title, 200); b.subtitle = str(o.subtitle, 300); b.author = str(o.author, 120);
  var imgs = {}; if (o.images && typeof o.images === 'object') for (id in o.images) {
    var r = o.images[id]; if (/^\w{1,20}$/.test(id) && r && typeof r.data === 'string' && /^data:image\/(jpeg|png|webp);base64,/.test(r.data) && +r.w > 0 && +r.h > 0) imgs[id] = { name: str(r.name, 120), data: r.data, w: +r.w, h: +r.h };
  }
