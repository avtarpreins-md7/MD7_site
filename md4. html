      var row = mk('div', { 'class': 'proj' }), info = mk('div'), b = mk('b', null, p.title || 'بدون عنوان');
      info.appendChild(b); info.appendChild(mk('small', null, new Date(p.updated).toLocaleString('ar-EG') + (p.id === S.id ? ' — المفتوح الآن' : '')));
      var act = mk('div', { 'class': 'row' }), o = mk('button', { type: 'button', 'class': 'btn line sm' }, 'فتح'), d = mk('button', { type: 'button', 'class': 'btn bad sm' }, 'حذف');
      o.addEventListener('click', function () { S = sanitizeBook(p) || S; S.id = p.id; imgEls = {}; ver++; pv.i = 0; syncFields(); setStatus($('saveStatus'), 'ok', 'فُتح المشروع: ' + (S.title || 'بدون عنوان')); refreshProjects(); });
      d.addEventListener('click', function () { if (confirm('حذف هذا المشروع المحفوظ نهائيًا؟')) dbDel(p.id).then(function () { if (S.id === p.id) S.id = null; refreshProjects(); }); });
