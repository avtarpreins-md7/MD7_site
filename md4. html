let chartTok=0,chartTimer;
function loadChartSoon(){clearTimeout(chartTimer);chartTimer=setTimeout(loadChart,350);}
async function loadChart(){
  const box=$('chart'), tok=++chartTok;
  if(S.from===S.to){box.innerHTML=`<div class="hint">${t('chartSame')}</div>`;return;}
  box.innerHTML=`<div class="hint">${t('chartLoad')}</div>`;
  const f=d=>d.toISOString().slice(0,10), end=new Date(), start=new Date(Date.now()-30*864e5);
  const ctrl=new AbortController(), to=setTimeout(()=>ctrl.abort(),10000);
  try{
    const r=await fetch(`https://api.frankfurter.dev/v1/${f(start)}..${f(end)}?base=${S.from}&symbols=${S.to}`,{signal:ctrl.signal});
    if(!r.ok) throw new Error('x'); const j=await r.json();
    if(tok!==chartTok) return;
    const pts=Object.keys(j.rates||{}).sort().map(d=>({d,v:j.rates[d][S.to]})).filter(p=>isFinite(p.v));
    if(pts.length<2) throw new Error('few');
    drawChart(pts);
  }catch(e){ if(tok===chartTok) box.innerHTML=`<div class="hint">${t('chartNone')}</div>`; }
  finally{clearTimeout(to);}
}
function drawChart(pts){
  const W=640,H=210,pl=10,pr=10,pt=18,pb=26, vs=pts.map(p=>p.v), mn=Math.min(...vs), mx=Math.max(...vs), rg=(mx-mn)||mn*0.01||1;
  const X=i=>pl+i*(W-pl-pr)/(pts.length-1), Y=v=>pt+(1-(v-mn)/rg)*(H-pt-pb), col=CUR[S.to].color, cc=mix(col,'#ffffff',.3);
  const line=pts.map((p,i)=>`${X(i).toFixed(1)},${Y(p.v).toFixed(1)}`).join(' ');
  const area=`${pl},${H-pb} ${line} ${W-pr},${H-pb}`;
  const ch=(pts[pts.length-1].v/pts[0].v-1)*100;
  $('chart').innerHTML=`<div class="kv"><span>1 ${S.from} → ${S.to}</span><b class="${ch>0?'pos':ch<0?'neg':'zero'}">${ch>0?'+':''}${fmt(ch,2)}% · ${fmtRate(pts[pts.length-1].v)}</b></div>
  <svg viewBox="0 0 ${W} ${H}" direction="ltr"><defs><linearGradient id="chg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="${cc}" stop-opacity=".45"/><stop offset="1" stop-color="${cc}" stop-opacity="0"/></linearGradient></defs>
  <polygon points="${area}" fill="url(#chg)"/><polyline points="${line}" fill="none" stroke="${cc}" stroke-width="2.4" stroke-linejoin="round"/>
  <circle cx="${X(pts.length-1)}" cy="${Y(pts[pts.length-1].v)}" r="4.5" fill="#d4af37"/>
  <text x="${pl}" y="12" fill="#c0c5ce" font-size="11">max ${fmtRate(mx)}</text><text x="${pl}" y="${H-pb-5}" fill="#c0c5ce" font-size="11">min ${fmtRate(mn)}</text>
  <text x="${pl}" y="${H-6}" fill="#7d8491" font-size="11">${pts[0].d}</text><text x="${W-pr}" y="${H-6}" fill="#7d8491" font-size="11" text-anchor="end">${pts[pts.length-1].d}</text></svg>`;
}

