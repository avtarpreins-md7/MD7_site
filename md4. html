  if(!(amt>0)) warn=t('eAmt'); else if(!(rate>0)) warn=t('eRateH'); else if(ft!=='none'&&!(feeVal>=0)) warn=t('eFeeH');
  $('homeWarn').textContent=warn; $('saveConv').disabled=!ok;
  if(!ok||S.from===S.to&&false){
    ['outNet','outGross','outFee','outRate','outInv','outBuy','outSell'].forEach(i=>$(i).textContent='—'); $('shareBar').innerHTML=''; $('shareTxt').textContent=''; return;
  }
  const r=calcConvert({amt,rate,feeType:ft,feeVal:ft==='none'?0:feeVal});
  $('outNet').textContent=fmt(r.net,tc.dec)+' '+tc.code;
  $('outNet').style.color=r.net<=0?'var(--red)':'';
  $('outGross').textContent=fmtM(r.gross,tc.code);
  $('outFee').textContent=fmtM(r.fee,tc.code);
  $('outRate').textContent='1 '+fc.code+' = '+fmtRate(rate)+' '+tc.code;
  $('outInv').textContent='1 '+tc.code+' = '+fmtRate(1/rate)+' '+fc.code;
  const s=Math.max(0,spread)/200;
  $('outBuy').textContent='1 '+fc.code+' = '+fmtRate(rate*(1-s))+' '+tc.code;
  $('outSell').textContent='1 '+fc.code+' = '+fmtRate(rate*(1+s))+' '+tc.code;
  const feeShare=r.gross>0?Math.min(100,Math.max(0,r.fee/r.gross*100)):0;
  $('shareBar').innerHTML=`<i style="width:${100-feeShare}%;background:linear-gradient(90deg,${tc.color},${mix(tc.color,'#ffffff',.35)})"></i><i style="width:${feeShare}%;background:var(--red)"></i>`;
  $('shareTxt').textContent=fmt(100-feeShare,1)+'% '+t('netL')+' · '+fmt(feeShare,1)+'% '+t('feeL');
  if(r.net<=0) $('homeWarn').textContent=t('eFeeBig');
}
