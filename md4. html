          if (e && e.name === 'AbortError') setStatus(st, 'warn', 'أُلغيت المشاركة.'); else { download(blob, name); setStatus(st, 'warn', 'تعذّرت المشاركة المباشرة، فنُزّل الملف على جهازك (' + mb + ' ميغابايت) لتشاركه يدويًا.'); }
        });
