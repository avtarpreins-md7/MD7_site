function projectBlob() { return new Blob([JSON.stringify(S)], { type: 'application/json' }); }
$('btnExpProj').addEventListener('click', function () { download(projectBlob(), safeName('.md4book.json')); setStatus($('fileStatus'), 'ok', 'نُزّل ملف المشروع. احتفظ به لاستيراده لاحقًا.'); });
