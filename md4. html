  });
}
$('btnSave').addEventListener('click', function () { saveProject(false); });
$('btnNew').addEventListener('click', function () { if (!confirm('بدء مشروع جديد؟ تأكد أنك حفظت المشروع الحالي.')) return; S = newBook(); imgEls = {}; ver++; pv.i = 0; syncFields(); clearStatus($('saveStatus')); refreshProjects(); });

/* ===== ملف المشروع: تصدير/استيراد مع تحقق ===== */
function str(v, max) { return typeof v === 'string' ? v.slice(0, max) : ''; }
function sanitizeBook(o) {
