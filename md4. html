  $('feeVal').disabled=(ft==='none');
  const bi=rateBadgeInfo(), bd=$('rateBadge'); bd.className='badge '+bi.cls; bd.textContent=bi.txt;
  let tm='—';
  if(S.manual) tm=t('bManual'); else if(S.meta&&S.rates) tm=S.meta.source+' · '+dtFmt(S.meta.updated||S.meta.fetched);
  $('outTime').textContent=tm;
  let warn='';
