<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MD7 NFT Gallery</title>
<style>
body{background:#0a0a0a;color:#fff;font-family:Arial;text-align:center;padding:20px}
h1{color:#00f5ff;font-size:2.5em}
.gallery{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:30px}
.card{background:#111;border:2px solid #00f5ff;border-radius:15px;padding:15px}
.card:hover{transform:scale(1.05)}
.card img{width:100%;border-radius:10px}
.btn{background:#00f5ff;color:#000;padding:12px 25px;border-radius:8px;text-decoration:none;display:inline-block;margin-top:10px;font-weight:bold}
</style>
</head>
<body>
<h1>MD7 NFT Gallery</h1>
<div class="gallery">
  <div class="card">
    <img src="https://i.imgur.com/xyz1.jpg">
    <h3>Cyberpunk</h3>
    <p>السعر: 0.5 TRUST</p>
    <a href="#" class="btn">اشتري الان</a>
  </div>
  <div class="card">
    <img src="https://i.imgur.com/xyz2.jpg">
    <h3>مدينة الاهرامات المستقبلية</h3>
    <p>السعر: 0.8 TRUST</p>
    <a href="#" class="btn">اشتري الان</a>
  </div>
  <div class="card">
    <img src="https://i.imgur.com/xyz3.jpg">
    <h3>القناع النيون بالرموز</h3>
    <p>السعر: 1.2 TRUST</p>
    <a href="#" class="btn">اشتري الان</a>
  </div>
</div>
</body>
</html>
