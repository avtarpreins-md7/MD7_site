<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>MD3 | سوق العرض والطلب</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Cairo', sans-serif; background: #050505; color: #fff; direction: rtl; padding: 20px; }
      .btn { background: #D4AF37; color: #000; border: none; padding: 10px 18px; font-weight: bold; border-radius: 6px; cursor: pointer; text-decoration: none; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-top: 20px; }
      .card { background: #121212; border: 1px solid #D4AF37; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; }
      .card img { width: 100%; height: 160px; object-fit: cover; background: #222; }
      .card-body { padding: 12px; }
      input { width: 100%; padding: 8px; margin: 5px 0; background: #000; border: 1px solid #333; color: #fff; border-radius: 4px; font-family: 'Cairo'; }
    </style>
</head>
<body>
<a href="index.html" class="btn">← العودة للرئيسية</a>

<div style="max-width:900px; margin:20px auto;">
    <h2 style="color:#D4AF37; margin-bottom:15px;">🛒 MD3: سوق عرض المنتجات والكتب</h2>

    <!-- نموذج إضافة منتج -->
    <div style="background:#121212; padding:15px; border-radius:8px; border:1px solid #333;">
        <h4 style="color:#D4AF37;">إضافة منتج جديد</h4>
        <input type="text" id="pName" placeholder="اسم المنتج">
        <input type="text" id="pPrice" placeholder="السعر (مثال: 15$)">
        <input type="text" id="pImg" placeholder="رابط الصورة (URL)">
        <button class="btn" style="margin-top:8px;" onclick="addP()">رفع المنتج</button>
    </div>

    <h3 style="margin-top:25px; color:#D4AF37;">المنتجات المعروضة</h3>
    <div class="grid" id="grid">
        <div class="card">
            <img src="https://via.placeholder.com/300x200/111/D4AF37?text=كتاب+الماتريكس" alt="منتج">
            <div class="card-body">
                <div style="font-weight:bold;">كتاب نهضة الماتريكس</div>
                <div style="color:#D4AF37; font-size:18px; font-weight:900; margin:5px 0;">15$</div>
                <a href="md2.html" class="btn" style="display:block; text-align:center; font-size:12px;">اعرض في MD2</a>
            </div>
        </div>
    </div>
</div>

<script>
  function addP() {
    const name = document.getElementById('pName').value;
    const price = document.getElementById('pPrice').value;
    const img = document.getElementById('pImg').value || 'https://via.placeholder.com/300x200/111/D4AF37?text=منتج';
    if(!name || !price) return alert('أدخل الاسم والسعر');

    const card = document.createElement('div');
    card.className = 'card';
    card.innerHTML = `
        <img src="${img}">
        <div class="card-body">
            <div style="font-weight:bold;">${name}</div>
            <div style="color:#D4AF37; font-size:18px; font-weight:900; margin:5px 0;">${price}</div>
            <a href="md2.html" class="btn" style="display:block; text-align:center; font-size:12px;">اعرض في MD2</a>
        </div>
    `;
    document.getElementById('grid').appendChild(card);
    document.getElementById('pName').value = ''; document.getElementById('pPrice').value = ''; document.getElementById('pImg').value = '';
  }
</script>
</body>
</html>
