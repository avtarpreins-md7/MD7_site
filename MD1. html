<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>MD1 - محول النص لكود</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo&display=swap" rel="stylesheet">
  <style>
    :root{--brown:#1a0f08; --gold:#d4af37;}
    body{background:var(--brown); color:#f5deb3; font-family:'Cairo'; padding:20px;}
   .settings{background:#2a1a10; padding:15px; border-radius:10px; border:1px solid var(--gold);}
    input{width:75%; padding:10px; background:#000; color:#fff; border:1px solid var(--gold);}
    textarea{width:100%; height:150px; background:#000; color:#fff; border:1px solid var(--gold);}
  .main{display:flex; gap:15px; flex-wrap:wrap;}
  .panel{flex:1; min-width:300px; background:#2a1a10; padding:15px; border:1px solid var(--gold);}
    pre{background:#000; color:#00ff88; height:400px; overflow:auto;}
    iframe{background:#fff; width:100%; height:400px;}
    button{background:var(--gold); color:#000; padding:12px; border:none; font-weight:bold; cursor:pointer; width:100%;}
  </style>
</head>
<body>
  <h1>🔧 MD1 - اكتب يتحول لكود</h1>
  <div class="settings">
    <input type="password" id="apiKeyMD1" placeholder="حط مفتاح Gemini API">
    <button onclick="localStorage.setItem('md1_api_key', document.getElementById('apiKeyMD1').value)">حفظ المفتاح</button>
  </div>
  <textarea id="userInputMD1" placeholder="مثال: اعملي هيدر لوصل 24"></textarea>
  <button onclick="generateCodeMD1()">شغل MD1</button>
  <div class="main">
    <div class="panel"><h3>الكود</h3><pre id="codeBoxMD1"></pre></div>
    <div class="panel"><h3>المعاينة</h3><iframe id="previewBoxMD1"></iframe></div>
  </div>
<script>
window.onload = () => document.getElementById('apiKeyMD1').value = localStorage.getItem('md1_api_key') || '';
async function generateCodeMD1() {
  const apiKey = document.getElementById('apiKeyMD1').value;
  const prompt = document.getElementById('userInputMD1').value;
  const fullPrompt = `حول الطلب لكود HTML كامل. ستايل بني وذهبي لبراند "وصل 24". RTL. رجع الكود فقط. الطلب: ${prompt}`;
  const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({contents:[{parts:[{text:fullPrompt}]}]})});
  const data = await res.json();
  let code = data.candidates[0].content.parts[0].text.replace(/```/g, '');
  document.getElementById('codeBoxMD1').innerText = code;
  document.getElementById('previewBoxMD1').srcdoc = code;
}
</script>
</body>
</html>
