<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>MD2 | منصة المؤلفين</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Cairo', sans-serif; background: #050505; color: #fff; direction: rtl; padding: 20px; }
      .container { max-width: 700px; margin: 40px auto; background: #121212; border: 1px solid #D4AF37; padding: 30px; border-radius: 12px; }
      textarea { width: 100%; padding: 12px; background: #000; border: 1px solid #333; color: #fff; border-radius: 6px; font-family: 'Cairo'; margin: 10px 0; }
      .btn { background: #D4AF37; color: #000; border: none; padding: 12px 20px; font-weight: bold; border-radius: 6px; cursor: pointer; text-decoration: none; display: inline-block; }
      .code-box { background: #000; border: 1px dashed #D4AF37; padding: 15px; border-radius: 6px; margin-top: 15px; display: none; }
    </style>
</head>
<body>
<a href="index.html" class="btn" style="margin-bottom:20px;">← العودة للرئيسية</a>
<div class="container">
    <h2 style="color:#D4AF37;">📚 MD2: مولد أكواد وصف الصور لـ Gemini</h2>
    <p style="color:#aaa; font-size:14px; margin-top:5px;">اكتب وصف المشهد، وسيقوم النظام بتنسيقه كأمر موجه لجيمناي جاهز للنسخ.</p>
    
    <textarea id="desc" rows="4" placeholder="صف المشهد المطلوبة (مثال: غلاف كتاب سينمائي عن الذكاء الاصطناعي)..."></textarea>
    <button class="btn" onclick="genPrompt()">توليد كود Gemini</button>

    <div id="result" class="code-box">
        <p style="color:#D4AF37; font-size:12px;">انسخ الكود وأرسله لـ Gemini:</p>
        <code id="promptCode" style="color:#00ffcc; word-break:break-all;"></code>
        <br><br>
        <button class="btn" style="font-size:12px;" onclick="copyCode()">نسخ الكود</button>
    </div>
</div>
<script>
  function genPrompt() {
    const txt = document.getElementById('desc').value;
    if(!txt) return alert('أدخل الوصف أولاً');
    document.getElementById('promptCode').innerText = `/generate_image prompt: "A hyper-realistic cinematic cover art, based on: ${txt}, 8k resolution, gold and black lighting, sharp focus"`;
    document.getElementById('result').style.display = 'block';
  }
  function copyCode() {
    navigator.clipboard.writeText(document.getElementById('promptCode').innerText);
    alert('تم النسخ!');
  }
</script>
</body>
</html>
